#!/usr/bin/env bash
#MISE description="Start Postgres and run the server on the host, rebuilding when a file changes"
#USAGE flag "--once" help="Run the server once instead of rebuilding on a change"
set -euo pipefail

# /setup returns 404 once an install has an account, unless sign-up is on. The
# seeded database has accounts.
export SPRIG_SIGNUP_ENABLED="true"
export SPRIG_LOG_FORMAT=text
# The session cookie drops Secure because WebKit refuses one over plain http,
# localhost included. The name loses its __Host- prefix, which is valid only on
# a Secure cookie.
export SPRIG_COOKIE_SECURE=false
export SPRIG_COOKIE_NAME=sprig_session
# Reading the templates from disk rather than from the copy embedded in the
# binary means an edit shows up on the next request instead of the next restart.
export SPRIG_TEMPLATE_DIR="${MISE_PROJECT_ROOT:?}/web/templates"
# Push is on so the Notifications page, the digest job and Send a test can be
# tried against a real browser. The pair is the same throwaway one compose.yaml
# gives the e2e app. It is fixed rather than generated per run, because a new
# pair would invalidate every subscription a development browser made.
export SPRIG_PUSH_ENABLED=true
export SPRIG_VAPID_PUBLIC_KEY=BIKy0ljeIkYXaxRwCtYWzL6mcXZ1uQRljQ9HlisKJLJiAWkvTHx6QKQNtjbZeP5AvsVqD6-lKh6RDeyszC8lu3A
export SPRIG_VAPID_PRIVATE_KEY=NYvCfU2w94nee-zA8CqDtHNwV7z9nKVjO3JyESW9mcs
export SPRIG_VAPID_SUBJECT=mailto:sprig@example.com

# Ctrl+C exits 0 so that mise does not report the task as failed.
trap 'exit 0' INT

# The container is left running so the next run only waits on the healthcheck.
docker compose up -d --wait db

# The dev tag adds the sign-in that stands in for passkeys. The image is built
# without it.
if [ "${usage_once:-false}" = "true" ]; then
  go run -tags dev ./cmd/sprig
else
  # wgo rebuilds and restarts on a change, watching .go on its own. The -file
  # flag adds .css and .js because web/static is compiled into the binary.
  wgo run -file='\.(css|js)$' -xdir='^(node_modules|e2e)$' -tags=dev ./cmd/sprig
fi
