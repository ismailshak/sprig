#!/usr/bin/env bash
#MISE description="Start Postgres and run the server on the host"
set -euo pipefail

export SPRIG_LOG_FORMAT=text

# Makes Ctrl+C stop the db container.
trap 'exit 0' INT
trap 'docker compose stop db' EXIT

docker compose up -d --wait db
# The dev tag adds the sign-in that stands in for passkeys. The image is built
# without it.
go run -tags dev ./cmd/sprig
