#!/usr/bin/env bash
#MISE description="Format the repository with prettier"
#USAGE flag "--check" help="List the files prettier would change and write nothing"
#USAGE flag "--pathspecs" help="Print the git pathspecs of the files prettier formats, one per line, and format nothing. The pre-commit hook reads them"
set -euo pipefail

cd "${MISE_PROJECT_ROOT:?}"

# The files prettier formats. With glob magic a * does not match a slash. The
# script glob stops at web/static and does not reach the vendored htmx below it.
pathspecs=(':(glob)e2e/**' ':(glob)*.md' ':(glob)web/static/*.js' ':(glob).vscode/*.json')

if [ "${usage_pathspecs:-false}" = "true" ]; then
  printf '%s\n' "${pathspecs[@]}"
  exit 0
fi

pnpm --dir e2e install --frozen-lockfile

mode=--write
if [ "${usage_check:-false}" = "true" ]; then
  mode=--check
fi

# --exclude-standard leaves out what git ignores. That includes a clone's own
# files listed in .git/info/exclude
files=()
while IFS= read -r -d '' file; do
  files+=("$file")
done < <(git ls-files -z --cached --others --exclude-standard -- "${pathspecs[@]}")

# The config and ignore file are named on the command line, because prettier
# would otherwise fall back to its defaults for a file outside e2e.
# --ignore-unknown skips the files under e2e that prettier has no parser for,
# such as the image fixtures.
e2e/node_modules/.bin/prettier "$mode" --config e2e/.prettierrc.json --ignore-path e2e/.prettierignore --ignore-unknown "${files[@]}"
