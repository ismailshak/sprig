#!/usr/bin/env bash
# Runs prettier over the staged files that mise run format covers. It stages the
# files it rewrites. A formatting fix never needs a second commit.
#
# A file that is only partly staged stops the hook instead, because staging
# prettier's fix would pull the unstaged rest of that file into the commit.
#
# Git finds this hook through core.hooksPath. mise run hooks sets it.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

prettier=e2e/node_modules/.bin/prettier
# The same settings mise run format passes
settings=(--config e2e/.prettierrc.json --ignore-path e2e/.prettierignore --ignore-unknown)

# Read into a variable first, because a failure inside < <(...) would not stop
# the hook. With no pathspecs, the git diff below lists every staged file.
listed=$(mise run --quiet format --pathspecs)
pathspecs=()
while IFS= read -r pathspec; do
  pathspecs+=("$pathspec")
done <<<"$listed"

files=()
while IFS= read -r -d '' file; do
  files+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- "${pathspecs[@]}")

if [ ${#files[@]} -eq 0 ]; then
  exit 0
fi

if [ ! -x "$prettier" ]; then
  echo "pre-commit: e2e has no prettier installed. Run mise run format." >&2
  exit 1
fi

unformatted=()
while IFS= read -r file; do
  unformatted+=("$file")
done < <("$prettier" "${settings[@]}" --list-different "${files[@]}")

if [ ${#unformatted[@]} -eq 0 ]; then
  exit 0
fi

held=()
for file in "${unformatted[@]}"; do
  if [ -n "$(git diff --name-only -- "$file")" ]; then
    held+=("$file")
  fi
done

if [ ${#held[@]} -ne 0 ]; then
  echo "pre-commit: these are staged in part and want formatting, so staging the fix would commit the rest:" >&2
  printf '  %s\n' "${held[@]}" >&2
  echo "Run mise run format and stage what you mean to commit." >&2
  exit 1
fi

"$prettier" "${settings[@]}" --write "${unformatted[@]}"
git add -- "${unformatted[@]}"
printf 'pre-commit: prettier formatted %s and staged the result.\n' "${unformatted[*]}"
