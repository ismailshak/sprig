#!/usr/bin/env bash
# Prettier over whatever the commit touches under e2e/, which is the only
# JavaScript in the repository. It checks rather than rewrites, because a hook
# that edits staged files commits something the author has not read.
#
# Git finds this through core.hooksPath, which mise run hooks sets.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r file; do
  case "$file" in
    e2e/*.ts | e2e/*.js | e2e/*.json | e2e/*.md | e2e/*.yml | e2e/*.yaml) files+=("${file#e2e/}") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ ${#files[@]} -eq 0 ]; then
  exit 0
fi

if [ ! -x e2e/node_modules/.bin/prettier ]; then
  echo "pre-commit: e2e has no prettier installed. Run mise run format." >&2
  exit 1
fi

cd e2e
if ! ./node_modules/.bin/prettier --check "${files[@]}"; then
  echo "pre-commit: run mise run format and stage what it changes." >&2
  exit 1
fi
