#!/usr/bin/env bash
# Runs prettier over the staged files under e2e/ and the staged scripts under
# web/static/, and stages what it rewrites, so a formatting fix never needs a
# second commit. prettier is installed under e2e/. Its config and ignore file are
# named on the command line, because prettier would otherwise fall back to its
# defaults for a file outside that directory.
#
# A file that is only partly staged stops the hook instead, because staging
# prettier's fix would pull the unstaged rest of that file into the commit.
#
# Git finds this hook through core.hooksPath, which mise run hooks sets.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

prettier=e2e/node_modules/.bin/prettier
settings=(--config e2e/.prettierrc.json --ignore-path e2e/.prettierignore)

files=()
while IFS= read -r file; do
  case "$file" in
    # The vendored htmx is left as it was downloaded. A * in a case pattern
    # matches a slash, so the pattern below would otherwise match it.
    web/static/vendor/*) ;;
    e2e/*.ts | e2e/*.js | e2e/*.json | e2e/*.md | e2e/*.yml | e2e/*.yaml | web/static/*.js) files+=("$file") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ ${#files[@]} -eq 0 ]; then
  exit 0
fi

if [ ! -x "$prettier" ]; then
  echo "pre-commit: e2e has no prettier installed. Run mise run format." >&2
  exit 1
fi

unformatted=()
while IFS= read -r file; do
  unformatted+=("$file")
done < <("$prettier" "${settings[@]}" --list-different "${files[@]}")

if [ ${#unformatted[@]} -eq 0 ]; then
  exit 0
fi

held=()
for file in "${unformatted[@]}"; do
  if [ -n "$(git diff --name-only -- "$file")" ]; then
    held+=("$file")
  fi
done

if [ ${#held[@]} -ne 0 ]; then
  echo "pre-commit: these are staged in part and want formatting, so staging the fix would commit the rest:" >&2
  printf '  %s\n' "${held[@]}" >&2
  echo "Run mise run format and stage what you mean to commit." >&2
  exit 1
fi

"$prettier" "${settings[@]}" --write "${unformatted[@]}"
git add -- "${unformatted[@]}"
printf 'pre-commit: prettier formatted %s and staged the result.\n' "${unformatted[*]}"
